<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="#080808">
 <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
 <LinearLayout android:id="@+id/welcome" android:layout_width="match_parent" android:layout_height="match_parent"
  android:gravity="center" android:orientation="vertical" android:padding="30dp" android:background="#080808">
  <ImageView android:layout_width="190dp" android:layout_height="190dp" android:src="@mipmap/ic_launcher"
   android:scaleType="fitCenter" android:contentDescription="@string/app_name"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp"
   android:text="@string/welcome" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="21sp"
   android:gravity="center"/>
 </LinearLayout>
</FrameLayout>